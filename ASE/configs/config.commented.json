// SpawnControl config. Same values as config.json, with comments. Comments are allowed in config.json too.
// Reload after editing with SpawnControl.Reload (admin console or RCON).
//
// To share one config between servers, this file can instead hold only
//   { "SharedConfig": "D:\\servers\\shared\\SpawnControl" }
// pointing at a shared file (this layout) or a folder (config.json for the settings below, Default.json, and
// one <section>.json per map with just that map's rules). See the README.
//
// A top-level "Default" section, next to "Maps", holds rules every map starts from; each map section is laid
// over it (objects merge, lists and values replace, null deletes a default entry). SpawnControl.Rules shows
// what a server ends up with and where each value came from.
{
  "General": {
    // Creatures removed per second at most. Removals queue up and drain at this rate, so a large cull
    // never lands in one tick.
    "RemovalsPerTick": 10,
    // Level actors looked at per second by the census. A full pass over a busy map takes a few seconds.
    "CensusActorsPerTick": 5000,
    // Seconds between census passes. Each pass recounts every wild creature and plans removals.
    "CensusIntervalSeconds": 60,
    // Creatures closer than this to any player (Unreal units, 300 = one foundation) are removed last.
    "NearPlayerDistance": 10000,
    // Once a minute, log how many creatures were removed and of which classes, largest first. Also gates the
    // under-mesh lines (up to 20 a minute, the rest counted in one line). List shows the same either way.
    "LogRemovals": true,
    // Zones choosing what to spawn skip entries whose creatures are all blocked or at their limit, so they
    // spawn other species instead of creatures that would only be removed again.
    "RefuseFullEntries": true,
    // Creatures summoned by another creature (a Gloon's Revenant escorts) are counted but never limited or
    // removed: the summoner would only replace them. Limit the summoner instead. A creature counts as
    // summoned when it appears after the first census without a spawn zone spawning it.
    "IgnoreSummoned": true
  },

  // Never touched by blocks or limits, on every map.
  "Protect": {
    // Class paths containing any of these. "/Missions/" covers outpost and mission creatures that
    // have their own classes.
    "PathContains": [ "/Missions/" ],
    // Classes deriving from any of these parents (e.g. "Thrall_Character_BP_Base_C" for all Thralls).
    "Families": []
  },

  // Rolling refresh: wild creatures are replaced a few at a time, oldest first, so the zones respawn them
  // with freshly rolled levels. Replaces a periodic full dino wipe. Ages count from server start.
  "Refresh": {
    // The whole wild population turns over in about this many hours. 0 turns the refresh off.
    // 24 h on ~20,000 creatures is about 14 per minute.
    "TurnoverHours": 24,
    // Never refresh a creature first seen less than this many minutes ago.
    "MinAgeMinutes": 60,
    // Never refresh a creature this close to any player (Unreal units; 30000 = 300 m), so nobody sees it go.
    "PlayerDistance": 30000,
    // Never refresh a creature that took damage within this many seconds (it may be in a fight).
    "RecentDamageSeconds": 300,
    // Classes whose path contains any of these are never refreshed: missions, Lost Colony Thralls and
    // their mounts (PatrolRepair looks after patrols), bosses. Tamed, mission-owned, protected,
    // unconscious, being-tamed and young creatures are never refreshed either.
    "SkipPathContains": [ "/Missions/", "Thrall", "Boss" ]
  },

  // Extra summary rows in SpawnControl.List: label -> parent class. Reporting only, no effect on removal.
  "ReportFamilies": {
    "Thralls": "Thrall_Character_BP_Base_C"
  },

  // One section per map. The section is picked by -SpawnControlMap=<section> on the server command line,
  // else by a section named after the -ServerKey= value when there is one, else by map name (ASA's "_WP"
  // suffix may be left off). SpawnControl.List shows which one is in use.
  //
  // Class keys: a short class name (Otter_Character_BP_C) matches every class of that name; a full path
  // as ListDinos prints it (/Game/.../Otter_Character_BP.Otter_Character_BP_C) matches exactly one. For
  // Limit, a full-path entry wins over a short-name entry for the same class.
  "Maps": {
    "LostColony": {
      // Wild creatures of these classes are removed as soon as they appear.
      "Block": [],
      // Maximum wild count per class on this map. 0 means no limit.
      "Limit": {
        "Baryonyx_Character_BP_C": 250,
        "Compy_Character_BP_C": 250,
        "Dimetro_Character_BP_C": 250,
        "Dodo_Character_BP_C": 250,
        "Pachyrhino_Character_BP_C": 250,
        "Sheep_Character_BP_C": 250,
        "Rhino_Character_BP_C": 250,
        "Phiomia_Character_BP_C": 250,
        "Ptero_Character_BP_C": 250,
        "Vulture_Character_BP_C": 250,
        "S-Argent_Character_BP_C": 250,
        "Bat_Character_BP_C": 200,
        "Bigfoot_Character_BP_C": 200,
        "Scorpion_Character_BP_C": 200,
        "Equus_Character_BP_C": 125,
        "Microraptor_Character_BP_C": 125,
        "Dragonfly_Character_BP_Tameable_C": 125,
        "S-Ankylo_Character_BP_C": 125,
        "S-Direbear_Character_BP_C": 125,
        "S-Direwolf_Character_BP_C": 125,
        "S-Doed_Character_BP_C": 125,
        "S-Owl_Character_BP_C": 125,
        "S-Trike_Character_BP_C": 125,
        "S-Yutyrannus_Character_BP_C": 125
      },
      // One shared maximum for several classes, e.g. a creature and its modded variant.
      "GroupLimit": {
        "Otters": {
          "Max": 200,
          "Classes": [ "Otter_Character_BP_C", "S-Otter_Character_BP_C" ]
        }
      },
      // Clump caps: no more than Max of a class in any cube AreaInFoundations across (300 units per
      // foundation). The key is a class, or a name with "Classes" to count several together, or "*" for
      // every wild creature. "Exclude" keeps classes out of a rule (packs meant to be dense); a short name
      // there also covers every class derived from it, e.g. every thrall, and one starting with "/" every
      // class whose path contains it, e.g. a whole folder. Checked each
      // census; the over-full spots are thinned, farthest from players first.
      "Density": {
        "Baryonyx_Character_BP_C": { "Max": 8, "AreaInFoundations": 30 },
        "*": { "Max": 40, "AreaInFoundations": 30, "Exclude": [ "Thrall_Character_BP_Base_C" ] }
      },
      // Where density rules do not apply: creatures the game spawned in caves or boss areas (ASA only), and
      // horizontal circles around a point (x, y from "ccc"; z is ignored), e.g. a city or a corrupted zone.
      "DensitySkip": {
        "Caves": true,
        "Areas": [
          { "Name": "City", "Location": [ 0, 0, 0 ], "RadiusInFoundations": 100 }
        ]
      },
      // Where no wild creature belongs, e.g. around a misplaced spawner or under the map. Every wild creature
      // inside is removed whatever its class (tames, mission and protected creatures excepted). A zone that
      // puts 3 creatures inside and none anywhere else has its spawn entries refused from then on, so it
      // stops spawning instead of refilling. With [x, y, z] the area is a sphere, so the ground above an
      // underground spot is untouched; with [x, y] it is a column at any height.
      // Creatures spawned inside one another: two overlap when their centres are closer than Fraction of
      // their summed collision radii. The one nearest a player stays, the rest are removed. Riders and
      // carried creatures are never counted. Leave the key out to turn this off.
      "Overlap": {
        "Fraction": 0.5,
        "Exclude": [ "Thrall_Character_BP_Base_C" ]
      },
      // Creatures under the map or inside rock, found with the game's own under-mesh test. Awake creatures
      // are tested at ChecksPerSecond; List and the log show what was found. With Remove, a creature found
      // below the surface on two separate censuses is removed (with its wild followers on ASA). Leave the
      // key out to turn it off.
      "UnderMesh": {
        "ChecksPerSecond": 20,
        "Remove": false,
        // Also test creatures in stasis, far from players: finds buried or broken spawners anywhere.
        // Raise ChecksPerSecond with it (about 200 covers a 21,000-creature map every census).
        "IncludeStasis": false,
        // With Remove: a spawn zone whose creatures keep being removed under the mesh (5 or more, with at most
        // one clear creature per 5 removed) is stopped, as block areas stop zones. List names each one; a reload
        // starts over. Zones that also spawn where creatures belong are never stopped.
        "StopZones": true,
        "Exclude": []
      },
      "BlockAreas": [
        { "Name": "Misplaced spawner", "Location": [ 0, 0, -60000 ], "RadiusInFoundations": 30 }
      ]
    }
  }
}
